PORT=8080
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://rusmedia:rusmedia@localhost:5432/rusmedia

# S3-compatible storage. Dev = MinIO, Prod = Cloudflare R2
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=rusmedia
S3_SECRET_ACCESS_KEY=rusmedia-secret-change-me
S3_PATH_STYLE=true
S3_BUCKET_ORIGINALS=rusmedia-originals
S3_BUCKET_DERIVED=rusmedia-derived
DERIVED_PUBLIC_BASE_URL=http://localhost:9000/rusmedia-derived

MAX_IMAGE_BYTES=26214400
MAX_VIDEO_BYTES=6442450944
UPLOAD_PART_BYTES=16777216

# Create buckets automatically on startup (dev). Set false in production if you manage them yourself.
AUTO_CREATE_BUCKETS=true
